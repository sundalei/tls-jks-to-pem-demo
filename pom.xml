<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.2.0</version>
    <relativePath/>
    <!-- lookup parent from repository -->
  </parent>
  <groupId>com.example</groupId>
  <artifactId>tls-jks-to-pem-demo</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <properties>
    <java.version>21</java.version>
    <spotless.version>3.11.0</spotless.version>
    <prettier.version>3.8.1</prettier.version>
    <prettier.plugin.xml.version>3.4.2</prettier.plugin.xml.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>tls-demo</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
              <formatJavadoc>true</formatJavadoc>
            </googleJavaFormat>
          </java>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <sortPom/>
          </pom>
          <formats>
            <format>
              <includes>
                <include>**/*.xml</include>
              </includes>
              <excludes>
                <exclude>**/pom.xml</exclude>
                <exclude>**/target/**</exclude>
                <exclude>**/node_modules/**</exclude>
              </excludes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
              <prettier>
                <devDependencyProperties>
                  <property>
                    <name>prettier</name>
                    <value>${prettier.version}</value>
                  </property>
                  <property>
                    <name>@prettier/plugin-xml</name>
                    <value>${prettier.plugin.xml.version}</value>
                  </property>
                </devDependencyProperties>
                <config>
                  <printWidth>120</printWidth>
                  <tabWidth>2</tabWidth>
                  <plugins>@prettier/plugin-xml</plugins>
                </config>
              </prettier>
            </format>
          </formats>
          <json>
            <includes>
              <include>**/*.json</include>
            </includes>
            <excludes>
              <exclude>**/target/**</exclude>
              <exclude>**/node_modules/**</exclude>
              <exclude>**/.devcontainer/*.json</exclude>
              <exclude>**/.github/linters/*.json</exclude>
            </excludes>
            <gson>
              <indentSpaces>2</indentSpaces>
              <sortByKeys>false</sortByKeys>
              <escapeHtml>false</escapeHtml>
            </gson>
          </json>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
